# Empty = browser calls same-origin `/api/...` (Next.js proxies to Railway).
# This avoids CORS issues between noorlink.co and api.noorlink.co.
NEXT_PUBLIC_API_URL=

# Worker / Route Handler → FastAPI on Railway
BACKEND_API_URL=https://api.noorlink.co

NEXT_PUBLIC_TAWK_PROPERTY_ID=6a83989070b1101d482a0b50
NEXT_PUBLIC_TAWK_WIDGET_ID=1k090nthp

# Public Trustpilot review form (baked into client at build time)
NEXT_PUBLIC_TRUSTPILOT_REVIEW_URL=https://www.trustpilot.com/evaluate/noorlink.co
