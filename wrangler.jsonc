{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noorlink-next-new",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "noorlink-next-new"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://api.noorlink.co",
		"BACKEND_API_URL": "https://api.noorlink.co"
	}
	// Custom domains are attached in the Cloudflare dashboard after Netlify DNS
	// records are fully removed (see DEPLOY.md). Putting them in wrangler while
	// leftover Netlify DNS exists can fail the deploy and break workers.dev (1042).
}
