{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noorlink-next-new",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "noorlink-next-new"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://api.noorlink.co",
		"BACKEND_API_URL": "https://api.noorlink.co"
	}
	// Do NOT declare custom domains here.
	// Apex (noorlink.co) is attached in the dashboard.
	// Declaring www via wrangler created an orphaned Workers-managed DNS
	// record and broke workers.dev with error 1042.
	// Use a Cloudflare Redirect Rule for www → https://noorlink.co (see DEPLOY.md).
}
