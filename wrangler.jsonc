{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noorlink-next-new",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "noorlink-next-new"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"r2_buckets": [
		{
			"binding": "SOCIAL_ASSETS",
			"bucket_name": "noorlink-social-assets"
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		// Browser uses same-origin /api proxy (see .env.production NEXT_PUBLIC_API_URL=)
		"BACKEND_API_URL": "https://api.noorlink.co",
		"NEXT_PUBLIC_TRUSTPILOT_REVIEW_URL": "https://www.trustpilot.com/evaluate/noorlink.co"
	},
	// Custom domains (noorlink.co, www) are attached in the Worker dashboard.
	// Keep routes out of wrangler.jsonc so GitHub Actions only needs
	// Account → Workers Scripts → Edit (Edit Cloudflare Workers template).
	// See DEPLOY.md → GitHub Actions.
}
