{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noorlink-next",
	// OpenNext entrypoint (produced by `opennextjs-cloudflare build`)
	"main": ".open-next/worker.js",
	// Must be >= 2025-05-05 for FinalizationRegistry / Next.js on Workers
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Static assets + Next.js chunks from the OpenNext build.
	// This is the correct "output mapping" — NOT pages_build_output_dir.
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Required for OpenNext caching / revalidation self-calls
			"binding": "WORKER_SELF_REFERENCE",
			"service": "noorlink-next"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
	// DO NOT add "pages_build_output_dir".
	// @opennextjs/cloudflare deploys as a Worker with static assets.
	// Traditional Cloudflare Pages output-dir deploys cause blank/white screens
	// because they never bind `.open-next/worker.js` + `.open-next/assets`.
}
