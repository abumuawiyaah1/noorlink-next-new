{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "noorlink-next-new",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-23",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "noorlink-next-new"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_API_URL": "https://api.noorlink.co",
		"BACKEND_API_URL": "https://api.noorlink.co"
	},
	// Apex is already attached in the dashboard. www often fails in the UI after
	// leaving Pages — deploy creates/updates the Worker custom domain + DNS.
	"routes": [
		{ "pattern": "noorlink.co", "custom_domain": true },
		{ "pattern": "www.noorlink.co", "custom_domain": true }
	]
}
