# Public API base for the browser.
# Leave empty in production so the app uses same-origin `/api/...` proxy.
# For local direct FastAPI: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=

# Server-side / proxy upstream (Railway)
BACKEND_API_URL=https://api.noorlink.co

# Tawk.to live chat (free tier)
# Defaults are baked in lib/tawk-config.ts — override here if needed
NEXT_PUBLIC_TAWK_PROPERTY_ID=6a83989070b1101d482a0b50
NEXT_PUBLIC_TAWK_WIDGET_ID=1k090nthp
